from fastapi import FastAPI
from langchain_google_genai import ChatGoogleGenerativeAI
from langchain_core.prompts import PromptTemplate
import os 
from fastapi.responses import JSONResponse
from dotenv import load_dotenv
import firebase_admin
from firebase_admin import credentials, firestore

# Load environment variables
load_dotenv()

# Get API keys from environment
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
OPENWEATHER_API_KEY = os.getenv("OPENWEATHER_API_KEY")

if not GEMINI_API_KEY:
    raise ValueError("❌ GEMINI_API_KEY not found in .env file")
if not OPENWEATHER_API_KEY:
    raise ValueError("❌ OPENWEATHER_API_KEY not found in .env file")

os.environ["GOOGLE_API_KEY"] = GEMINI_API_KEY

# Initialize Firebase
# IMPORTANT: Update this path to your Firebase Admin SDK JSON file
FIREBASE_CREDENTIALS_PATH = "cookvision-9bb7f-firebase-adminsdk-fbsvc-23d96ad1fd.json"

cred = credentials.Certificate(FIREBASE_CREDENTIALS_PATH)
firebase_admin.initialize_app(cred)
db = firestore.client()

# Initialize LLM
llm = ChatGoogleGenerativeAI(
    model="gemini-2.5-flash",
    max_retries=0,
    temperature=0
)

app = FastAPI()

# Add your endpoints here...

@app.get("/")
def read_root():
    return {"health": "ok"}

@app.get("/health")
def health_check():
    return {"status": "healthy"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
